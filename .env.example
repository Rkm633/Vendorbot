# ==============================================================================
# Vendor WhatsApp Bot Node - Stateless Environment Configuration
# Deployable on Render / Railway / Koyeb with ZERO Database required!
# ==============================================================================

# HTTP Server Port (Render / Railway / Koyeb auto-injects PORT)
PORT=3000

# 1. REQUIRED: Your Multi-Vendor Mall Central Brain Node Base URL
# Example: https://api.yourmall.com
CENTRAL_NODE_URL=https://api.yourmall.com

# 2. REQUIRED: Unique Vendor Node API Key (generated in your Vendor Dashboard)
# Authenticates both outbound bootstrap/events and inbound real-time website webhooks
VENDOR_API_KEY=vnd_live_replace_with_your_vendor_api_key

# 3. OPTIONAL: Public URL of this deployed Vendor Bot (auto-detected on Render/Railway/Koyeb)
# Sent to Central Node on boot so website carts/orders push to this bot in real time
# BOT_PUBLIC_URL=https://my-shop-bot.onrender.com

# 4. OPTIONAL: Bot Operating Mode (auto-determined from Central Brain bootstrap/sync payload `bot_mode`)
# Allowed values: vendor_store (default) | admin_vendor_manager
# BOT_MODE=vendor_store

# 5. OPTIONAL: Fallback LLM API keys if not supplied by Central Node AI config
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
